{
  "mcpServers": {
    "mac-control": {
      "command": "/bin/sh",
      "args": [
        "/path/to/mac-control-mcp/scripts/run-server.sh"
      ]
    },
    "mac-exec": {
      "command": "/bin/sh",
      "args": [
        "/path/to/mac-control-mcp/scripts/run-exec-server.sh"
      ],
      "env": {
        "MAC_EXEC_WORKSPACE": "~/AgentWorkspace"
      }
    }
  }
}
